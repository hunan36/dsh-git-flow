{
  "name": "dsh-git-flow",
  "version": "0.3.0-rc.3",
  "description": "Workspace git branch switcher, commit composer with AI-written messages, and push for DeepSeek Harness",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "git",
    "branch",
    "commit"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.1.7-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsdown --watch"
  }
}
